
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - FF Tournament</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>body { background: #0f0f0f; color: white; }.card { background: #1a1a1a; border: 1px solid #ff4d00; }</style>
</head>
<body class="d-flex align-items-center vh-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card p-4 shadow">
                    <h3 class="text-center text-warning">Create Account</h3>
                    <form action="/register" method="POST">
                        <input type="text" name="username" class="form-control mb-3" placeholder="Full Name" required>
                        <input type="email" name="email" class="form-control mb-3" placeholder="Email Address" required>
                        <input type="text" name="uid" class="form-control mb-3" placeholder="Free Fire UID" required>
                        <input type="password" name="password" class="form-control mb-3" placeholder="Password" required>
                        <button class="btn btn-warning w-100 fw-bold">Sign Up</button>
                    </form>
                    <p class="mt-3 text-center">Already have an account? <a href="/login" class="text-warning">Login</a></p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
