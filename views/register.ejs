<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - Make Your Tour FF</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body style="background-color: var(--bg-color);">

    <div class="auth-container">
        <h1 class="auth-title" style="margin-top: 50px;">Let's Start</h1>
        <p class="auth-subtitle">Create an account</p>

        <h3 class="text-start mb-4" style="color: #64748b;">Sign Up</h3>

        <form action="/register" method="POST">
            <div class="input-group-custom">
                <input type="text" name="username" placeholder="UserName" required>
            </div>

            <div class="input-group-custom">
                <input type="email" name="email" placeholder="Email Address" required>
            </div>

            <div class="input-group-custom">
                <input type="text" name="uid" placeholder="Mobile Number" required>
            </div>

            <div class="input-group-custom">
                <input type="password" name="password" placeholder="Password" required>
            </div>

            <div class="text-start px-2 small">
                <input type="checkbox" required> I agree to the Terms and Conditions and Privacy Policy
            </div>

            <button type="submit" class="btn-auth">Create Account</button>
        </form>

        <a href="/login" class="auth-link">Already have an account? <span>Sign In</span></a>
    </div>

</body>
</html>
