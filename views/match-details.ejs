<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Match Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="p-3 border-bottom border-secondary d-flex align-items-center">
        <a href="/" class="text-white me-3"><i class="fas fa-chevron-left"></i></a>
        <h6 class="mb-0">FreeFire FullMap Matches</h6>
    </div>

    <div class="container mt-3">
        <!-- Match Header Info -->
        <div class="match-item m-0 mb-3">
            <div class="d-flex justify-content-between">
                <h6 class="text-primary text-uppercase"><%= match.title %></h6>
                <span class="badge bg-success">#<%= match._id.toString().slice(-5) %></span>
            </div>
            <p class="small text-muted"><%= match.date %> at <%= match.time %></p>

            <div class="match-info-grid">
                <div class="match-info-box">
                    <small>WIN PRIZE</small>
                    <p><%= match.prize %> TK</p>
                </div>
                <div class="match-info-box">
                    <small>PER KILL</small>
                    <p><%= match.perKill %> TK</p>
                </div>
                <div class="match-info-box">
                    <small>ENTRY FEE</small>
                    <p><%= match.entryFee %> TK</p>
                </div>
            </div>

            <div class="mt-3">
                <div class="d-flex justify-content-between small">
                    <span>Only <%= match.totalSlots - match.joinedPlayers.length %> spots left</span>
                    <span><%= match.joinedPlayers.length %>/<%= match.totalSlots %></span>
                </div>
                <div class="progress">
                    <div class="progress-bar" style="width: <%= (match.joinedPlayers.length / match.totalSlots) * 100 %>%"></div>
                </div>
            </div>

            <div class="row g-2 mt-2">
                <div class="col-6"><button class="btn btn-outline-secondary btn-sm w-100"><i class="fas fa-key"></i> Room Details</button></div>
                <div class="col-6"><button class="btn btn-outline-secondary btn-sm w-100"><i class="fas fa-trophy"></i> Prize Pool</button></div>
            </div>
            
            <% if(match.joinedPlayers.length >= match.totalSlots) { %>
                <button class="btn btn-secondary w-100 mt-3" disabled>Match Full</button>
            <% } else { %>
                <a href="/join-match/<%= match._id %>" class="btn btn-join mt-3">Join Now</a>
            <% } %>
        </div>

        <!-- Participants List (Like Screenshot 9) -->
        <div class="p-3 bg-dark rounded">
            <h6 class="text-center border-bottom border-secondary pb-2">Registered Participants</h6>
            <div class="list-group mt-2">
                <% match.joinedPlayers.forEach((player, index) => { %>
                    <div class="list-group-item bg-transparent text-white border-secondary d-flex justify-content-between">
                        <span><%= index + 1 %>. <%= player.username %></span>
                        <span class="text-muted small"><%= player.teamType %></span>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</body>
</html>
