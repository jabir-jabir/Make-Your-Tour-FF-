<!-- Inside views/profile.ejs -->
<div class="container mt-4 text-center">
    <div class="profile-header p-4">
        <img src="https://ui-avatars.com/api/?name=<%= user.username %>" class="rounded-circle border border-info" width="80">
        <h4 class="mt-2"><%= user.username %></h4>
        <p class="text-muted">UID: <%= user.uid %></p>
    </div>

    <div class="row g-3">
        <div class="col-6">
            <div class="p-3 bg-dark rounded shadow-sm">
                <small class="text-muted">Matches Played</small>
                <h5 class="mb-0">0</h5>
            </div>
        </div>
        <div class="col-6">
            <div class="p-3 bg-dark rounded shadow-sm">
                <small class="text-muted">Total Won</small>
                <h5 class="mb-0 text-success">৳0</h5>
            </div>
        </div>
    </div>

    <div class="list-group mt-4 text-start">
        <a href="/wallet" class="list-group-item list-group-item-action bg-dark text-white border-secondary py-3">
            <i class="fas fa-wallet me-3 text-primary"></i> Wallet & Withdraw
        </a>
        <a href="/rules" class="list-group-item list-group-item-action bg-dark text-white border-secondary py-3">
            <i class="fas fa-book me-3 text-warning"></i> All Rules
        </a>
        <a href="/logout" class="list-group-item list-group-item-action bg-dark text-danger border-secondary py-3">
            <i class="fas fa-sign-out-alt me-3"></i> Logout
        </a>
    </div>
</div>
