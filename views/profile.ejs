<div class="container text-center mt-4">
    <div class="profile-card p-4">
        <img src="https://ui-avatars.com/api/?name=<%= user.username %>" class="rounded-circle border border-info" width="80">
        <h4 class="mt-2 text-primary"><%= user.username %></h4>
        <div class="d-flex justify-content-around mt-3">
            <div><small class="text-muted">Matches</small><h6>0</h6></div>
            <div><small class="text-muted">Balance</small><h6>৳<%= user.wallet %></h6></div>
            <div><small class="text-muted">Won</small><h6>0</h6></div>
        </div>
    </div>

    <!-- List Items like Screenshot -->
    <div class="mt-4 px-3">
        <div class="d-flex justify-content-between p-3 border-bottom border-secondary">
            <span><i class="fas fa-wallet me-3"></i> Wallet</span>
            <i class="fas fa-chevron-right"></i>
        </div>
        <div class="d-flex justify-content-between p-3 border-bottom border-secondary">
            <span><i class="fas fa-history me-3"></i> Withdraw History</span>
            <i class="fas fa-chevron-right"></i>
        </div>
        <div class="d-flex justify-content-between p-3 border-bottom border-secondary">
            <span><i class="fas fa-shield-alt me-3"></i> All Rules</span>
            <i class="fas fa-chevron-right"></i>
        </div>
        <a href="/logout" class="btn btn-danger w-100 mt-4">Logout</a>
    </div>
</div>
