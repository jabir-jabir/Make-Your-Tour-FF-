<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Make Your Tour FF</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ডিজাইন ঠিক রাখার জন্য অতিরিক্ত CSS */
        .category-card { text-decoration: none !important; color: white !important; display: block; }
        .category-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    </style>
</head>
<body style="background-color: #050811;">

    <!-- Header -->
    <div class="p-3 d-flex justify-content-between align-items-center">
        <h4 class="fw-bold" style="color: var(--primary);">Make Your Tour FF</h4>
        <div class="badge bg-dark p-2" style="border: 1px solid var(--primary);">
            ৳<%= user ? user.wallet : 0 %>
        </div>
    </div>

    <!-- ডাইনামিক স্লাইডার ব্যানার -->
    <div class="container mb-3">
        <div id="bannerSlider" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner shadow-lg" style="border-radius: 15px;">
                <% if(banners && banners.length > 0) { %>
                    <% banners.forEach((banner, index) => { %>
                        <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                            <img src="<%= banner.imageUrl %>" class="d-block w-100" style="height: 180px; object-fit: cover;">
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="carousel-item active">
                        <div style="background: linear-gradient(135deg, #004e92, #00d2ff); height: 180px; display:flex; align-items:center; justify-content:center; border-radius: 15px;">
                            <h3 class="text-white">ব্যানার অ্যাড করুন</h3>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Notice Bar -->
    <div class="notice-bar mx-3">
        <i class="fas fa-bullhorn me-2 text-warning"></i>
        <marquee class="small">আপনাদের যেকোনো প্রয়োজনে আমাদের টেলিগ্রাম সাপোর্ট এ যোগাযোগ করুন।</marquee>
    </div>

    <!-- ক্যাটাগরি গ্রিড -->
    <div class="container mt-4 mb-5">
        <h5 class="mb-3 text-uppercase fw-bold text-secondary">FREE FIRE</h5>
        <div class="category-grid">
            <a href="/category/BR-Duo" class="category-card">
                <div class="card bg-dark border-0">
                    <img src="/images/duo.jpg" class="card-img-top" style="height: 110px; object-fit: cover; opacity: 0.8;">
                    <div class="card-body p-2 text-center" style="background: #1e293b; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
                        <span class="small fw-bold">BR DUO MATCH</span>
                    </div>
                </div>
            </a>
            <a href="/category/BR-Solo" class="category-card">
                <div class="card bg-dark border-0">
                    <img src="/images/solo.jpg" class="card-img-top" style="height: 110px; object-fit: cover; opacity: 0.8;">
                    <div class="card-body p-2 text-center" style="background: #1e293b; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
                        <span class="small fw-bold">BR SOLO MATCH</span>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Bottom Nav -->
    <div class="bottom-nav">
        <a href="/" class="nav-tab active"><i class="fas fa-gamepad"></i>Play</a>
        <a href="/my-matches" class="nav-tab"><i class="fas fa-list-ul"></i>Matches</a>
        <a href="/results" class="nav-tab"><i class="fas fa-poll"></i>Results</a>
        <a href="/profile" class="nav-tab"><i class="fas fa-user-circle"></i>Profile</a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
