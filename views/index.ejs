<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Make Your Tour FF</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body style="background-color: #050811;">

    <!-- Header -->
    <div class="p-3 d-flex justify-content-between align-items-center">
        <h4 class="fw-bold" style="color: var(--primary);">Make Your Tour FF</h4>
        <div class="badge bg-dark p-2" style="border: 1px solid var(--primary);">
            ৳<%= user ? user.wallet : 0 %>
        </div>
    </div>

    <!-- Dynamic Slider Banner -->
    <div class="container mb-3">
        <div id="bannerSlider" class="carousel slide shadow-lg" data-bs-ride="carousel">
            <div class="carousel-inner" style="border-radius: 15px;">
                <% if(banners && banners.length > 0) { %>
                    <% banners.forEach((banner, index) => { %>
                        <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                            <img src="<%= banner.imageUrl %>" class="d-block w-100" style="height: 180px; object-fit: cover;">
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="carousel-item active">
                        <div style="background: linear-gradient(135deg, #004e92, #00d2ff); height: 180px; display:flex; align-items:center; justify-content:center;">
                            <h3 class="text-white">ব্যানার নেই</h3>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Notice Bar -->
    <div class="notice-bar mx-3">
        <i class="fas fa-bullhorn me-2 text-warning"></i>
        <marquee class="small">আপনাদের যেকোনো প্রয়োজনে আমাদের টেলিগ্রাম সাপোর্ট এ যোগাযোগ করুন।</marquee>
    </div>

    <!-- Categories Section (হুবহু স্ক্রিনশট ৪ এর মতো) -->
    <div class="container mt-4 mb-5">
        <h5 class="mb-3 text-uppercase fw-bold text-secondary">FREE FIRE</h5>
        <div class="category-grid">
            <a href="/category/BR-Duo" class="category-card">
                <span class="category-tag">BR</span>
                <img src="https://via.placeholder.com/400x200/0f172a/00e5ff?text=BR+DUO" alt="Duo">
                <div class="category-title">BR DUO MATCH</div>
            </a>
            <a href="/category/BR-Solo" class="category-card">
                <span class="category-tag">BR</span>
                <img src="https://via.placeholder.com/400x200/0f172a/00e5ff?text=BR+SOLO" alt="Solo">
                <div class="category-title">BR SOLO MATCH</div>
            </a>
            <a href="/category/BR-Squad" class="category-card">
                <span class="category-tag">BS</span>
                <img src="https://via.placeholder.com/400x200/0f172a/00e5ff?text=BR+SQUAD" alt="Squad">
                <div class="category-title">BR SQUAD SURVIVAL</div>
            </a>
            <a href="/category/CS-Mode" class="category-card">
                <span class="category-tag">CS</span>
                <img src="https://via.placeholder.com/400x200/0f172a/00e5ff?text=CLASH+SQUAD" alt="CS">
                <div class="category-title">CLASH SQUAD</div>
            </a>
        </div>
    </div>

    <!-- Bottom Nav Bar -->
    <div class="bottom-nav">
        <a href="/" class="nav-tab active"><i class="fas fa-gamepad"></i>Play</a>
        <a href="/my-matches" class="nav-tab"><i class="fas fa-list-ul"></i>Matches</a>
        <a href="/results" class="nav-tab"><i class="fas fa-poll"></i>Results</a>
        <a href="/profile" class="nav-tab"><i class="fas fa-user-circle"></i>Profile</a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
