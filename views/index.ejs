<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FF Tournament BD</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #0f0f0f; color: white; }
        .match-card { background: #1e1e1e; border: 1px solid #ff4d00; border-radius: 10px; margin-bottom: 20px; }
        .btn-join { background-color: #ff4d00; color: white; font-weight: bold; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand text-warning" href="#">FF TOURNAMENT</a>
        </div>
    </nav>

    <div class="container mt-4">
        <h2 class="text-center mb-4">Upcoming Tournaments</h2>
        
        <!-- Match 1 -->
        <div class="match-card p-3 shadow">
            <div class="row align-items-center">
                <div class="col-8">
                    <h4>Solo Battle Royale</h4>
                    <p class="mb-1 text-secondary">Time: 09:00 PM | Entry: ৳20</p>
                    <p class="text-warning">Prize Pool: ৳100</p>
                </div>
                <div class="col-4 text-end">
                    <a href="#" class="btn btn-join">Join Now</a>
                </div>
            </div>
        </div>

        <!-- Match 2 -->
        <div class="match-card p-3 shadow">
            <div class="row align-items-center">
                <div class="col-8">
                    <h4>Duo Rush Hour</h4>
                    <p class="mb-1 text-secondary">Time: 10:30 PM | Entry: ৳40</p>
                    <p class="text-warning">Prize Pool: ৳200</p>
                </div>
                <div class="col-4 text-end">
                    <a href="#" class="btn btn-join">Join Now</a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
