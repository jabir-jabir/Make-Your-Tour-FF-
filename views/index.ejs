<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FF Tournament BD</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #0d0d0d; color: white; }
        .navbar { border-bottom: 2px solid #ff4d00; }
        .match-card { background: #1a1a1a; border-radius: 15px; border-left: 5px solid #ff4d00; transition: 0.3s; }
        .match-card:hover { transform: scale(1.02); }
        .btn-join { background: linear-gradient(45deg, #ff4d00, #ff8800); color: white; border: none; font-weight: bold; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark bg-black py-3">
        <div class="container">
            <a class="navbar-brand fw-bold text-warning" href="/">FF PRO LEAGUE</a>
            <div>
                <% if (user) { %>
                    <span class="me-3 text-white">Wallet: ৳<%= user.wallet %></span>
                    <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
                <% } else { %>
                    <a href="/login" class="btn btn-warning btn-sm fw-bold">Login</a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        <h2 class="mb-4">Live & Upcoming Matches</h2>
        <div class="row">
            <% if(matches.length > 0) { %>
                <% matches.forEach(match => { %>
                    <div class="col-md-6 mb-4">
                        <div class="match-card p-4 shadow">
                            <div class="d-flex justify-content-between">
                                <h4 class="text-warning"><%= match.title %></h4>
                                <span class="badge bg-danger"><%= match.version %></span>
                            </div>
                            <p class="text-secondary mb-1">Time: <%= match.time %> | Map: <%= match.map %></p>
                            <div class="row mt-3">
                                <div class="col-6">
                                    <p class="mb-0 text-secondary">Entry Fee</p>
                                    <h5>৳<%= match.entryFee %></h5>
                                </div>
                                <div class="col-6 text-end">
                                    <p class="mb-0 text-secondary">Prize Pool</p>
                                    <h5>৳<%= match.prize %></h5>
                                </div>
                            </div>
                            <a href="/join/<%= match._id %>" class="btn btn-join w-100 mt-3">JOIN NOW</a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="text-center text-secondary">No matches available right now. Check back later!</p>
            <% } %>
        </div>
    </div>
</body>
</html>
