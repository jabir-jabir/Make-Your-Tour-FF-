<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Make Your Tour FF</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <!-- Top Header -->
    <div class="container py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0 text-primary-color" style="color: #00d2ff;">Make Your Tour FF</h5>
            <small class="text-muted">Battle • Win • Earn</small>
        </div>
        <div class="wallet-badge p-2 px-3" style="background: #1e293b; border-radius: 20px;">
            <i class="fas fa-wallet text-warning me-2"></i> ৳<%= user ? user.wallet : 0 %>
        </div>
    </div>

    <!-- Banner Carousel (Simplified) -->
    <div class="container mb-4">
        <div class="p-4 text-center" style="background: var(--accent-gradient); border-radius: 15px;">
            <h4 class="mb-1">JOIN MEGA TOURNAMENT</h4>
            <p class="small mb-0">Get 2x rewards on every kill!</p>
        </div>
    </div>

    <!-- Match List -->
    <div class="container">
        <h6 class="mb-3">LIVE MATCHES</h6>
        
        <% if(matches.length > 0) { %>
            <% matches.forEach(match => { %>
                <div class="match-card p-3">
                    <div class="row">
                        <div class="col-4">
                            <div style="background: #2563eb; height: 80px; border-radius: 10px; display:flex; align-items:center; justify-content:center;">
                                <i class="fas fa-gamepad fa-2x"></i>
                            </div>
                        </div>
                        <div class="col-8">
                            <h6 class="mb-1 text-uppercase"><%= match.title %></h6>
                            <p class="small text-muted mb-2"><i class="far fa-clock"></i> <%= match.time %></p>
                            
                            <div class="d-flex justify-content-between text-center bg-dark p-2 rounded">
                                <div>
                                    <small class="d-block text-muted">PRIZE</small>
                                    <span class="fw-bold">৳<%= match.prize %></span>
                                </div>
                                <div>
                                    <small class="d-block text-muted">PER KILL</small>
                                    <span class="fw-bold">৳5</span>
                                </div>
                                <div>
                                    <small class="d-block text-muted">ENTRY</small>
                                    <span class="fw-bold text-success">৳<%= match.entryFee %></span>
                                </div>
                            </div>
                            
                            <button class="btn btn-primary-custom w-100 mt-3">JOIN NOW</button>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="text-center p-5">
                <i class="fas fa-ghost fa-3x text-muted mb-3"></i>
                <p class="text-muted">No matches found!</p>
            </div>
        <% } %>
    </div>

    <!-- App-like Bottom Nav -->
    <div class="bottom-nav">
        <a href="/" class="nav-item active"><i class="fas fa-play d-block"></i>Play</a>
        <a href="/my-matches" class="nav-item"><i class="fas fa-list d-block"></i>Matches</a>
        <a href="/results" class="nav-item"><i class="fas fa-chart-bar d-block"></i>Results</a>
        <a href="/profile" class="nav-item"><i class="fas fa-user d-block"></i>Profile</a>
    </div>

</body>
</html>
