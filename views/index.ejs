<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Make Your Tour FF</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <!-- Header -->
    <div class="p-3 d-flex justify-content-between">
        <h4 class="fw-bold" style="color: var(--primary);">Make Your Tour FF</h4>
        <div class="badge bg-dark p-2">৳<%= user ? user.wallet : 0 %></div>
    </div>

    <!-- Banner (Image slider placeholder) -->
    <div class="container mb-3">
        <div style="background: linear-gradient(to right, #004e92, #000428); height: 150px; border-radius: 15px; display:flex; align-items:center; padding: 20px;">
            <h3>কিভাবে ম্যাচ খেলবেন?</h3>
        </div>
    </div>

    <!-- Notice Bar -->
    <div class="notice-bar">
        <i class="fas fa-bullhorn me-2 text-warning"></i>
        <marquee class="small">আপনাদের যেকোনো প্রয়োজনে আমাদের টেলিগ্রাম সাপোর্ট এ যোগাযোগ করুন।</marquee>
    </div>

    <!-- Categories like Screenshot 4 -->
    <div class="container">
        <h5 class="mb-3">FREE FIRE</h5>
        <div class="row g-3">
            <div class="col-6">
                <div class="category-card">
                    <span class="category-tag">BR</span>
                    <img src="https://via.placeholder.com/150" alt="Duo">
                    <div class="p-2 text-center small fw-bold">BR DUO MATCH</div>
                </div>
            </div>
            <div class="col-6">
                <div class="category-card">
                    <span class="category-tag">BR</span>
                    <img src="https://via.placeholder.com/150" alt="Solo">
                    <div class="p-2 text-center small fw-bold">BR SOLO MATCH</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Nav Bar -->
    <div class="bottom-nav">
        <a href="/" class="nav-tab active"><i class="fas fa-gamepad"></i>Play</a>
        <a href="/my-matches" class="nav-tab"><i class="fas fa-list-ul"></i>My Matches</a>
        <a href="/results" class="nav-tab"><i class="fas fa-poll"></i>Results</a>
        <a href="/profile" class="nav-tab"><i class="fas fa-user-circle"></i>Profile</a>
    </div>

</body>
</html>
